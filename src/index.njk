---
layout: layouts/base.njk
title: Home
permalink: /
---

<header class="hero">
  <h1>{{ site.title }}</h1>
  <p class="tagline">{{ site.description }}</p>
  <p class="intro">Cloud Developer student based in Sweden. Building modern applications with a focus on Infrastructure as Code, containerization, and cloud-native development.</p>
</header>

<main class="main-content">
  <section class="nav-section">
    <h2>Professional</h2>
    <p>My background, skills, and experience.</p>
    <ul class="nav-links">
      <li><a href="/resume/">Resume</a></li>
    </ul>
  </section>

  <section class="nav-section">
    <h2>Personal</h2>
    <p>Interests, hobbies, and things I care about.</p>
    <p class="coming-soon">Coming soon</p>
  </section>

  <nav class="social-links">
{% if site.social.github %}
    <a href="{{ site.social.github }}" target="_blank" rel="noopener">GitHub</a>
    {% endif %}
    {% if site.social.linkedin %}
    <a href="{{ site.social.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
    {% endif %}
    {% if site.social.email %}
    <a href="mailto:{{ site.social.email }}">Email</a>
    {% endif %}
  </nav>
</main>
